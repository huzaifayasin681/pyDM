{
  "manifest_version": 3,
  "name": "PyDM Integration",
  "version": "2.0",
  "description": "Download files and videos with PyDM \u2013 fast, resumable downloads with a video grabber for YouTube, TikTok, Instagram and more.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "webRequest",
    "cookies",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PyDM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}